{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aimux",
  "version": "../package.json",
  "identifier": "dev.aimux.desktop",
  "build": {
    "beforeDevCommand": "bun run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "aimux",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQjEzOUVCRUE2RDQwQzEKUldUQlFHM3E2em14YlpWWk1VeHpQd2ZXdWY1TkZZQ2Zwa1RxM3ViZHhTaVlKK2htcWxLU3F5aEMK",
      "endpoints": [
        "https://github.com/nbardavid/aimux-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
