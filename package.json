    "@xterm/xterm": "5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10",
    "remark-gfm": "4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "@types/react": "^19.1.8",
